-- ==================== ฟังก์ชันที่ 1: ฟาร์มโทเค็น (วาร์ปไปเก็บ หลบไกล 1,000 สตัด แล้วกลับจุดเดิม) ====================
Tab:CreateToggle({
   Name = "ฟาร์มโทเค็นออโต้ (Token Farm)",
   CurrentValue = false,
   Flag = "TokenFarmFlag",
   Callback = function(Value)
      _G.TokenFarm = Value
      
      task.spawn(function()
         local originalPos = nil
         local safePlatform = nil
         
         while _G.TokenFarm do
            task.wait(0.5)
            pcall(function()
               local character = LocalPlayer.Character
               if character and character:FindFirstChild("HumanoidRootPart") then
                  local rootPart = character.HumanoidRootPart
                  
                  local targetToken = nil
                  for _, obj in pairs(workspace:GetDescendants()) do
                     if not _G.TokenFarm then break end
                     local name = string.lower(obj.Name)
                     if name:find("token") or name:find("money") or name:find("cash") or name:find("pickup") then
                        if obj:IsA("ProximityPrompt") and obj.Parent then
                           targetToken = obj.Parent
                           break
                        elseif obj:IsA("BasePart") then
                           targetToken = obj
                           break
                        end
                     end
                  end
                  
                  if targetToken then
                     if not originalPos then
                        originalPos = rootPart.CFrame
                     end
                     
                     if not safePlatform or not safePlatform.Parent then
                        safePlatform = Instance.new("Part")
                        safePlatform.Size = Vector3.new(20, 1, 20)
                        safePlatform.Position = rootPart.Position + Vector3.new(0, 1000, 0)
                        safePlatform.Anchored = true
                        safePlatform.Transparency = 0.5
                        safePlatform.Parent = workspace
                     end
                     
                     rootPart.CFrame = targetToken.CFrame + Vector3.new(0, 3, 0)
                     task.wait(0.3)
                     
                     for _, p in pairs(targetToken:GetDescendants()) do
                        if p:IsA("ProximityPrompt") then
                           fireproximityprompt(p)
                        end
                     end
                     task.wait(0.2)
                     
                     if originalPos then
                        rootPart.CFrame = originalPos
                     end
                  end
               end
            end)
         end
         
         if safePlatform then
            safePlatform:Destroy()
         end
      end)
   end,
})

