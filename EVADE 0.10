JumpBtnCorner.CornerRadius = UDim.new(0, 6)
JumpBtnCorner.Parent = InnerJumpToggleBtn

local isJumpActive = false
InnerJumpToggleBtn.MouseButton1Click:Connect(function()
    isJumpActive = not isJumpActive
    if isJumpActive then
        InnerJumpToggleBtn.Text = "Auto Jump: ON"
        InnerJumpToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
    else
        InnerJumpToggleBtn.Text = "Auto Jump: OFF"
        InnerJumpToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)

task.spawn(function()
    while true do
        task.wait(0.05)
        if isJumpActive then
            pcall(function()
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("Humanoid") then
                    local humanoid = character.Humanoid
                    if humanoid.FloorMaterial ~= Enum.Material.Air then
                        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                    end
                end
            end)
        end
    end
end)

MainTab:Toggle({
    Title = "เปิดหน้าต่างลอย Auto Jump (GUI)",
    Desc = "แสดงปุ่มควบคุมการกระโดดรัวบนหน้าจอ",
    Value = false,
    Callback = function(Value)
        JumpGui.Enabled = Value
        if not Value then
            isJumpActive = false
            InnerJumpToggleBtn.Text = "Auto Jump: OFF"
            InnerJumpToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        end
    end
})

