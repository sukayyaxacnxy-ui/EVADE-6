-- ==================== TAB 2: ระบบมองทะลุ (ESP พร้อมระบบเปลี่ยนสีเอง) ====================
local function createESP(targetModel, nameText, color, isBot)
    if not targetModel then return end
    
    local root = targetModel:FindFirstChild("HumanoidRootPart") or targetModel.PrimaryPart or targetModel:FindFirstChildWhichIsA("BasePart")
    if not root then return end

    local highlight = targetModel:FindFirstChild("EvadeESP_Highlight")
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "EvadeESP_Highlight"
        highlight.Adornee = targetModel
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0.2
        highlight.Parent = targetModel
    end
    highlight.FillColor = color

    local billboard = targetModel:FindFirstChild("EvadeESP_Billboard")
    if not billboard then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "EvadeESP_Billboard"
        billboard.Adornee = root
        billboard.Size = UDim2.new(0, 160, 0, 40)
        billboard.StudsOffset = Vector3.new(0, 3.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = targetModel

        local textLabel = Instance.new("TextLabel")
        textLabel.Name = "ESPText"
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.TextStrokeTransparency = 0
        textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        textLabel.TextSize = isBot and 15 or 12
        textLabel.Font = Enum.Font.GothamBold
        textLabel.Parent = billboard
    end

    local textLabel = billboard:FindFirstChild("ESPText")
    if textLabel then
        textLabel.TextColor3 = color
    end
end

local function clearESP(targetModel)
    if not targetModel then return end
    local hl = targetModel:FindFirstChild("EvadeESP_Highlight")
    if hl then hl:Destroy() end
    local bb = targetModel:FindFirstChild("EvadeESP_Billboard")
    if bb then bb:Destroy() end
end

RunService.RenderStepped:Connect(function()
    pcall(function()
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        clearESP(myChar)

        -- ESP ผู้เล่นคนอื่น
        if _G.ESP_Players then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local char = player.Character
                    local targetRoot = char:FindFirstChild("HumanoidRootPart")
                    if targetRoot then
                        createESP(char, player.DisplayName, _G.PlayerESPColor, false)
                        local bb = char:FindFirstChild("EvadeESP_Billboard")
                        if bb and bb:FindFirstChild("ESPText") then
                            local dist = math.floor((myRoot.Position - targetRoot.Position).Magnitude)
                            bb.ESPText.Text = string.format("%s\n[%d เมตร]", player.DisplayName, dist)
                        end
                    end
                end
            end
        else
            for _, player in pairs(Players:GetPlayers()) do
                if player.Character then clearESP(player.Character) end
            end
        end

        -- ESP บอท / Nextbot
        if _G.ESP_Bots then
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj ~= myChar then
                    local isPlayerChar = false
                    for _, p in pairs(Players:GetPlayers()) do
                        if p.Character == obj then isPlayerChar = true break end
                    end
                    
                    if not isPlayerChar and (obj:FindFirstChild("Humanoid") or obj:FindFirstChild("Nextbot") or string.lower(obj.Name):find("bot") or string.lower(obj.Name):find("ai")) then
                        local targetRoot = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                        if targetRoot then
                            createESP(obj, "⚠️ " .. obj.Name .. " ⚠️", _G.BotESPColor, true)
                            local bb = obj:FindFirstChild("EvadeESP_Billboard")
                            if bb and bb:FindFirstChild("ESPText") then
                                local dist = math.floor((myRoot.Position - targetRoot.Position).Magnitude)
                                bb.ESPText.Text = string.format("⚠️ %s ⚠️\n[ห่าง: %d เมตร]", obj.Name, dist)
                            end
                        end
                    end
                end
            end
        else
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj:FindFirstChild("EvadeESP_Billboard") then
                    local isPlayerChar = false
                    for _, p in pairs(Players:GetPlayers()) do
                        if p.Character == obj then isPlayerChar = true break end
                    end
                    if not isPlayerChar then clearESP(obj) end
                end
            end
        end
    end)
end)

