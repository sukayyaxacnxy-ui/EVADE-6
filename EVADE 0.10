local InnerJumpToggleBtn = Instance.new("TextButton")
InnerJumpToggleBtn.Size = UDim2.new(0.8, 0, 0, 30)
InnerJumpToggleBtn.Position = UDim2.new(0.1, 0, 0.45, 0)
InnerJumpToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
InnerJumpToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
InnerJumpToggleBtn.Text = "Auto Jump: OFF"
InnerJumpToggleBtn.TextSize = 13
InnerJumpToggleBtn.Font = Enum.Font.GothamBold
