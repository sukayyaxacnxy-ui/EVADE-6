-- ตัวแปรควบคุมสถานะและสี
local _G = _G
_G.TokenFarm = false
_G.AutoJump = false
_G.PlayerSpeed = 16
_G.NoclipEnabled = false
_G.ESP_Players = false
_G.ESP_Bots = false
_G.PlayerESPColor = Color3.fromRGB(80, 255, 120) -- สีเขียวเริ่มต้นสำหรับผู้เล่น
_G.BotESPColor = Color3.fromRGB(255, 60, 60)      -- สีแดงเริ่มต้นสำหรับบอท

-- Service พื้นฐาน
