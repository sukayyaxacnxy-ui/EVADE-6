-- ==================== ฟังก์ชันที่ 1: ฟาร์มโทเค็น (แก้ไขไม่ให้วาร์ปติดบนรถ/สิ่งกีดขวาง และเก็บสำเร็จแล้วกลับ) ====================
Tab:CreateToggle({
   Name = "ฟาร์มโทเค็นออโต้ (Token Farm)",
   CurrentValue = false,
   Flag = "TokenFarmFlag",
   Callback = function(Value)
      _G.TokenFarm = Value
      
      task.spawn(function()
         local originalPos = nil
         local safePlatform = nil
         
         while _G.TokenFarm do
            task.wait(0.6)
            pcall(function()
               local character = LocalPlayer.Character
               if character and character:FindFirstChild("HumanoidRootPart") then
                  local rootPart = character.HumanoidRootPart
                  
                  -- ค้นหาโทเค็น เฉพาะที่เป็นของจริงและไม่ใช่พาร์ทยานพาหนะ/รถ
                  local targetToken = nil
                  for _, obj in pairs(workspace:GetDescendants()) do
                     if not _G.TokenFarm then break end
                     local name = string.lower(obj.Name)
                     -- กรองคำที่ไม่ใช่รถหรือสิ่งปลูกสร้างขนาดใหญ่
                     if (name:find("token") or name:find("money") or name:find("cash") or name:find("pickup")) and not name:find("car") and not name:find("vehicle") and not name:find("bus") then
                        if obj:IsA("ProximityPrompt") and obj.Parent then
                           -- เช็คว่า Parent ไม่ใช่รถ
                           local parentName = string.lower(obj.Parent.Name)
                           if not parentName:find("car") and not parentName:find("vehicle") then
                              targetToken = obj.Parent
                              break
                           end
                        elseif obj:IsA("BasePart") then
                           targetToken = obj
                           break
                        end
                     end
                  end
                  
                  if targetToken then
                     if not originalPos then
                        originalPos = rootPart.CFrame
                     end
                     
                     -- สร้างแพลตฟอร์มลอยฟ้าสำหรับหลบ
                     if not safePlatform or not safePlatform.Parent then
                        safePlatform = Instance.new("Part")
                        safePlatform.Size = Vector3.new(20, 1, 20)
                        safePlatform.Position = rootPart.Position + Vector3.new(0, 1000, 0)
                        safePlatform.Anchored = true
                        safePlatform.Transparency = 0.5
                        safePlatform.Parent = workspace
                     end
                     
                     -- วาร์ปไปเหนือโทเค็นเล็กน้อยเพื่อให้เก็บได้ทันทีโดยไม่ติดชนวัตถุ
                     rootPart.CFrame = targetToken.CFrame + Vector3.new(0, 5, 0)
                     task.wait(0.2)
                     
                     -- ยิง ProximityPrompt เพื่อเก็บไอเทม
                     for _, p in pairs(targetToken:GetDescendants()) do
                        if p:IsA("ProximityPrompt") then
                           fireproximityprompt(p)
                        end
                     end
                     task.wait(0.2)
                     
                     -- วาร์ปกลับจุดเดิม
                     if originalPos then
                        rootPart.CFrame = originalPos
                     end
                  end
               end
            end)
         end
         
         if safePlatform then
            safePlatform:Destroy()
         end
      end)
   end,
})

