-- ==================== ระบบเสริม: ระบบบิน (Fly) ====================
local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

local flying = false
local flySpeed = 5
local bodyVelocity, bodyGyro

local function startFly()
    character = LocalPlayer.Character
    if not character then return end
    humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoidRootPart or not humanoid then return end

    flying = true
    humanoid.PlatformStand = true

    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Parent = humanoidRootPart

    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.P = 9e4
    bodyGyro.MaxTorque = Vector3.new(9e4, 9e4, 9e4)
    bodyGyro.CFrame = humanoidRootPart.CFrame
    bodyGyro.Parent = humanoidRootPart

    task.spawn(function()
        local camera = workspace.CurrentCamera
        local uis = game:GetService("UserInputService")
        
        while flying do
            task.wait()
            local moveDirection = Vector3.new(0, 0, 0)
            local forward = camera.CFrame.LookVector
            local right = camera.CFrame.RightVector
            
            if uis:IsKeyDown(Enum.KeyCode.W) or uis:IsKeyDown(Enum.KeyCode.Up) then
                moveDirection = moveDirection + forward
            end
            if uis:IsKeyDown(Enum.KeyCode.S) or uis:IsKeyDown(Enum.KeyCode.Down) then
                moveDirection = moveDirection - forward
            end
            if uis:IsKeyDown(Enum.KeyCode.A) or uis:IsKeyDown(Enum.KeyCode.Left) then
                moveDirection = moveDirection - right
            end
            if uis:IsKeyDown(Enum.KeyCode.D) or uis:IsKeyDown(Enum.KeyCode.Right) then
                moveDirection = moveDirection + right
            end
            
            if humanoid.MoveDirection.Magnitude > 0 then
                local camLook = Vector3.new(forward.X, 0, forward.Z).Unit
                local camRight = Vector3.new(right.X, 0, right.Z).Unit
                local moveDot = humanoid.MoveDirection:Dot(camLook)
                
                if moveDot > 0.3 then
                    moveDirection = moveDirection + forward
                elseif moveDot < -0.3 then
                    moveDirection = moveDirection - forward
                end
                
                local rightDot = humanoid.MoveDirection:Dot(camRight)
                if rightDot > 0.3 then
                    moveDirection = moveDirection + right
                elseif rightDot < -0.3 then
                    moveDirection = moveDirection - right
                end
            end
            
            bodyVelocity.Velocity = moveDirection * (flySpeed * 10)
            bodyGyro.CFrame = camera.CFrame
            humanoidRootPart.RotVelocity = Vector3.new(0, 0, 0)
        end
    end)
end

local function stopFly()
    flying = false
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
        end
    end
    if bodyVelocity then bodyVelocity:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end
end

